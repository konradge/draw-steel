{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawsteel.local/schemas/statblock.json",
  "title": "Draw Steel Monster Statblock",
  "description": "Schema for a Draw Steel (Cthulhu Workshop) monster statblock, inferred from exported JSON examples. Fields marked [app] are generated by the app on import and may be synthesized or omitted when converting from a PDF.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Monster name."
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "description": "Monster level / echelon."
    },
    "role": {
      "type": "string",
      "description": "Combat role, e.g. \"Ambusher\". Empty when none."
    },
    "organization": {
      "type": "string",
      "description": "Encounter organization, e.g. \"Solo\", \"Minion\", or an organization name."
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Creature types, e.g. [\"Human\", \"Humanoid\"]."
    },
    "encounterValue": {
      "type": "integer",
      "minimum": 0,
      "description": "Encounter value."
    },
    "stamina": {
      "type": "integer",
      "description": "Stamina. May be negative for creatures that survive below 0 (see traits)."
    },
    "weaknesses": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Damage-type weaknesses."
    },
    "immunities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Immunities, e.g. \"Poison 2\"."
    },
    "speed": {
      "type": "integer",
      "minimum": 0,
      "description": "Movement speed in squares per turn."
    },
    "mobilityTraits": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mobility traits, e.g. \"Fly\", \"Climb\", \"swim\", \"hover\"."
    },
    "size": {
      "type": "string",
      "enum": ["1S", "1M", "1L", "2S", "2M", "2L", "3S", "3M", "3L"],
      "description": "Size: echelon (1-3) + size class (S/M/L)."
    },
    "stability": {
      "type": "integer",
      "description": "Stability (starting Stability score)."
    },
    "captainBenefit": {
      "type": "string",
      "description": "Benefit granted to the Captain while this monster is the captain. Empty when none."
    },
    "freeStrike": {
      "type": "integer",
      "minimum": 0,
      "description": "Free strike damage / dice value."
    },
    "might": { "type": "integer", "description": "Might characteristic. May be negative (e.g. -1 for 1st echelon humans)." },
    "agility": { "type": "integer", "description": "Agility characteristic. May be negative." },
    "reason": { "type": "integer", "description": "Reason characteristic. May be positive or negative." },
    "intuition": { "type": "integer", "description": "Intuition characteristic. May be positive or negative." },
    "presence": { "type": "integer", "description": "Presence characteristic. May be negative." },
    "tokenImage": {
      "description": "[app] Token image reference from the app asset library. Not derivable from a PDF; may be null or omitted.",
      "type": ["object", "null"],
      "properties": {
        "assetId": { "type": "string", "description": "Asset path, e.g. \"monsters/ajax\"." },
        "source": { "type": "string", "description": "Markdown credit/source of the image." },
        "id": { "$ref": "#/$defs/appId" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["assetId", "source", "id", "createdAt", "updatedAt"],
      "additionalProperties": false
    },
    "public": { "type": "boolean", "description": "[app] Visibility flag." },
    "source": { "type": "string", "description": "[app] Record origin, e.g. \"Community\"." },
    "isOwner": { "type": "boolean", "description": "[app] Whether the current user owns the record." },
    "monsterBand": {
      "$ref": "#/$defs/monsterBand"
    },
    "features": {
      "type": "array",
      "description": "Monster features and abilities, in sheet order.",
      "items": { "$ref": "#/$defs/feature" }
    },
    "minion": {
      "type": "boolean",
      "description": "True if this is a minion statblock."
    },
    "id": { "$ref": "#/$defs/appId" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "required": [
    "name",
    "level",
    "role",
    "organization",
    "type",
    "encounterValue",
    "stamina",
    "weaknesses",
    "immunities",
    "speed",
    "mobilityTraits",
    "size",
    "stability",
    "captainBenefit",
    "freeStrike",
    "might",
    "agility",
    "reason",
    "intuition",
    "presence",
    "tokenImage",
    "public",
    "source",
    "isOwner",
    "monsterBand",
    "features",
    "minion",
    "id",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "appId": {
      "description": "[app] Short opaque identifier generated by the app (base62-ish, ~10 chars).",
      "type": "string",
      "pattern": "^[A-Za-z0-9]{6,16}$"
    },
    "timestamp": {
      "description": "[app] UTC timestamp with microsecond precision and Z suffix, e.g. 2026-10-27T16:50:51.363365Z.",
      "type": "string",
      "format": "date-time"
    },
    "abilityType": {
      "description": "Action type. Observed: \"Main Action\", \"Maneuver\", \"Triggered Action\", \"Villain Action 1\" / \"2\" / \"3\". Empty for traits.",
      "type": "string"
    },
    "roll": {
      "description": "Damage/test roll expression, e.g. \"2d10 + 5\". Empty when the feature has no roll.",
      "type": "string"
    },
    "keyword": {
      "description": "Observed keywords: Area, Charge, Magic, Melee, Ranged, Strike, Weapon.",
      "type": "string"
    },
    "feature": {
      "type": "object",
      "properties": {
        "featureType": {
          "type": "string",
          "enum": ["trait", "ability"],
          "description": "\"trait\" for passive traits (body text in `text`, no `outcomes`), \"ability\" for actions and powers."
        },
        "name": { "type": "string" },
        "text": { "type": "string", "description": "Trait body text. Empty for abilities (their prose lives in `outcomes`)." },
        "type": { "$ref": "#/$defs/abilityType" },
        "roll": { "$ref": "#/$defs/roll" },
        "cost": { "type": "string", "description": "Cost, e.g. \"2 Malice\". Empty when no cost." },
        "signature": { "type": "boolean", "description": "True for the monster's signature ability." },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/keyword" } },
        "distance": { "type": "string", "description": "Reach/distance, e.g. \"Melee 1\", \"Ranged 10\", \"5 burst\", \"Self\", \"3 cube within 10\"." },
        "target": { "type": "string", "description": "Targeting, e.g. \"One creature or object\", \"The triggering creature\", \"Special\"." },
        "trigger": { "type": "string", "description": "Trigger condition. Only used for Triggered Actions." },
        "ordinal": { "type": "integer", "minimum": 1 },
        "outcomes": {
          "type": "array",
          "description": "Sub-blocks of the ability. Always starts with a \"powerRoll\" (when there is one), followed by one or more \"effect\" blocks (Effect, Malice options, Special, ...). Empty for traits.",
          "items": { "$ref": "#/$defs/outcome" }
        },
        "id": { "$ref": "#/$defs/appId" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "featureType",
        "name",
        "text",
        "type",
        "roll",
        "cost",
        "signature",
        "keywords",
        "distance",
        "target",
        "trigger",
        "ordinal",
        "outcomes",
        "id",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["powerRoll", "effect"],
          "description": "\"powerRoll\" holds the tier1/tier2/tier3 result table; \"effect\" holds prose with a name such as \"Effect\", \"Special\", or a Malice cost label."
        },
        "name": { "type": "string", "description": "Empty for powerRoll; e.g. \"Effect\" / \"Special\" / \"1+ Malice\" for effects." },
        "text": { "type": "string", "description": "Effect prose. Empty for powerRoll." },
        "tier1": { "type": "string", "description": "Result at potency/echelon tier 1 (lowest). powerRoll only." },
        "tier2": { "type": "string", "description": "Result at tier 2. powerRoll only." },
        "tier3": { "type": "string", "description": "Result at tier 3 (highest). powerRoll only." },
        "ordinal": { "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/$defs/appId" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "type",
        "name",
        "text",
        "tier1",
        "tier2",
        "tier3",
        "ordinal",
        "id",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "maliceFeatureItem": {
      "description": "An entry inside a Malice feature. Type is \"text\" (prose), \"ability\" (an ability summary with keywords/distance/target but no roll outcomes), or \"powerRoll\" (tiered result table).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string", "description": "Prose for \"text\" entries. Empty for \"ability\" and \"powerRoll\"." },
        "type": {
          "type": "string",
          "enum": ["text", "ability", "powerRoll"]
        },
        "tier1": { "type": "string" },
        "tier2": { "type": "string" },
        "tier3": { "type": "string" },
        "abilityType": { "$ref": "#/$defs/abilityType" },
        "roll": { "$ref": "#/$defs/roll" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/keyword" } },
        "distance": { "type": "string" },
        "target": { "type": "string" },
        "trigger": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/$defs/appId" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "name",
        "description",
        "type",
        "tier1",
        "tier2",
        "tier3",
        "abilityType",
        "roll",
        "keywords",
        "distance",
        "target",
        "trigger",
        "ordinal",
        "id",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "maliceFeature": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string", "description": "Usually empty; the prose is carried by the items." },
        "cost": { "type": "string", "description": "Malice cost, e.g. \"2 Malice\"." },
        "minimumEchelon": {
          "type": "integer",
          "minimum": 1,
          "description": "Lowest echelon at which this feature is available."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/maliceFeatureItem" }
        },
        "id": { "$ref": "#/$defs/appId" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "name",
        "description",
        "cost",
        "minimumEchelon",
        "items",
        "id",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "monsterBand": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Band name, often the monster name plus \" (Copy)\" for single-monster bands." },
        "description": { "type": "string" },
        "public": { "type": "boolean" },
        "source": { "type": "string" },
        "sections": {
          "description": "Encounter sections. Empty in both examples; element shape unknown.",
          "type": "array",
          "items": {}
        },
        "maliceFeatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/maliceFeature" }
        },
        "monsters": {
          "description": "Other monsters in the band. Empty in both examples; element shape unknown (likely monster references/ids).",
          "type": "array",
          "items": {}
        },
        "id": { "$ref": "#/$defs/appId" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "required": [
        "name",
        "description",
        "public",
        "source",
        "sections",
        "maliceFeatures",
        "monsters",
        "id",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  }
}
